import numpy as np
import pandas as pd
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense,Dropout,Input,Activation,BatchNormalization
from tensorflow.keras.optimizers import Adam
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_squared_error,r2_score
from tensorflow.keras.callbacks import EarlyStopping
import matplotlib.pyplot as plt

np.random.seed(42)
n = 5000

# Core parameters with realistic ranges
power = np.random.choice([100, 200, 315, 500, 630, 800, 1000, 1250, 1600, 2000, 
                          2500, 3150, 4000, 5000, 6300, 8000, 10000], n)
hv = np.random.choice([3.3, 6.0, 6.6, 7.2, 9.0, 10, 11, 12, 13.8, 15, 20, 22, 
                       30, 33, 35, 38, 45, 66], n)
lv = np.random.choice([0.4, 0.415, 3.3, 6.0, 6.6, 11], n)

# Derived currents (approx)
hv_current = power / (hv * 1.732) * np.random.uniform(0.95, 1.05, n)
lv_current = power / (lv * 1.732) * np.random.uniform(0.95, 1.05, n)

# Losses correlated with power
noload_loss = (power * 1.2 + np.random.normal(0, 200, n)).clip(100, None)
full_load_loss = (power * 8.5 + np.random.normal(0, 1500, n)).clip(500, None)
copper_75 = full_load_loss * np.random.uniform(1.05, 1.12, n)

# Other params
imp_voltage = np.random.uniform(4.0, 9.5, n)
noload_current = np.random.uniform(0.3, 2.2, n)
cooling = np.random.choice(['ONAN', 'ONAF', 'OFAF', 'ODAF'], n, p=[0.4, 0.3, 0.2, 0.1])
vector = np.random.choice(['Dyn11', 'Yyn0', 'Ynd11'], n, p=[0.6, 0.25, 0.15])
ambient = np.random.normal(25, 4, n).clip(15, 40)
oil = np.random.choice(['Mineral', 'Synthetic'], n, p=[0.7, 0.3])
age = np.random.exponential(10, n).clip(0, 30).astype(int)


# CALCULATE y (EFFICIENCY) 
# GOVERNING EQUATION
pf = 0.85
output_power = power * pf
total_losses = noload_loss + copper_75

# Aging degradation
aging_factor = 1 + (age * 0.002)
total_losses_aged = total_losses * aging_factor

# Efficiency (%)
y_efficiency = (output_power / (output_power + total_losses_aged)) * 100
y_efficiency += np.random.normal(0, 0.05, n)
y_efficiency = np.clip(y_efficiency, 90, 99.9)

# CREATE DATAFRAME
df = pd.DataFrame({
    'power': power,
    'hv': hv,
    'lv': lv,
    'np.round(hv_current, 1)': np.round(hv_current, 1),
    'np.round(hv_current, 1)': np.round(hv_current, 1),
    'np.round(noload_loss, 0)': np.round(noload_loss, 0),
    'np.round(full_load_loss, 0)': np.round(full_load_loss, 0),
    'np.round(copper_75, 0)': np.round(copper_75, 0),
    'np.round(imp_voltage, 2)': np.round(imp_voltage, 2),
    'np.round(noload_current, 2)': np.round(noload_current, 2),
    'Cooling_Mode': cooling,
    'Vector_Group': vector,
    'np.round(ambient, 1)': np.round(ambient, 1),
    'Oil_Type': oil,
    'age': age,
    'Efficiency_%': np.round(y_efficiency, 3)  # TARGET (y)
})


# print(df.head(10))
# print(f"\n Target variable (Efficiency):")
# print(f"Range: {df['Efficiency_%'].min():.2f}% to {df['Efficiency_%'].max():.2f}%")
# print(f"Mean: {df['Efficiency_%'].mean():.2f}%")
# print(f"Std Dev: {df['Efficiency_%'].std():.2f}%")
X = df.drop(columns=['Efficiency_%'])
y = df['Efficiency_%'].values

X = pd.get_dummies(X, columns=['Cooling_Mode', 'Vector_Group', 'Oil_Type'], drop_first=True)

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42)
X_train,X_val, y_train,y_val =train_test_split(X_train,y_train, test_size=0.25,random_state=42)

X_scaler = StandardScaler().fit(X_train)
y_scaler = StandardScaler().fit(y_train.reshape(-1,1))

X_train_s = X_scaler.transform(X_train)
X_val_s = X_scaler.transform(X_val)
X_test_s = X_scaler.transform(X_test)

y_train_s = y_scaler.transform(y_train.reshape(-1,1))
y_val_s = y_scaler.transform(y_val.reshape(-1,1))
y_test_s = y_scaler.transform(y_test.reshape(-1,1))

n_features =X_train_s.shape[1]
n_features

model = Sequential([
Input(shape=(n_features,)),
Dense(128),Activation('relu'),BatchNormalization(),Dropout(0.20),
Dense(64),Activation('relu'),BatchNormalization(),Dropout(0.30),
Dense(32),Activation('relu'),BatchNormalization(),Dropout(0.10),
Dense(16),Activation('relu'),BatchNormalization(),Dropout(0.20),
Dense(8),Activation('relu'),BatchNormalization(),Dropout(0.20),
Dense(4),Activation('relu'),BatchNormalization(),Dropout(0.10),
Dense(1,activation='linear')
])
model.summary()




